```env
# =========================
# APP CONFIG
# =========================
APP_NAME=LumiIA
APP_ENV=development
PORT=3000

# =========================
# SUPABASE
# =========================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# DATABASE
# =========================
DB_HOST=
DB_PORT=5432
DB_NAME=lumiia_db
DB_USER=
DB_PASSWORD=
DB_ENGINE=postgresql

# =========================
# AUTH
# =========================
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# =========================
# AI CONFIG
# =========================
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
MAX_TOKENS=1000

# =========================
# FRONTEND URL
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# FILE STORAGE
# =========================
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=10485760

# =========================
# LOGGING
# =========================
LOG_LEVEL=debug

# =========================
# EMAIL CONFIG (OPTIONAL)
# =========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# =========================
# FLUTTER ENV
# =========================
FLUTTER_SUPABASE_URL=
FLUTTER_SUPABASE_ANON_KEY=
```
